# dnstree reads a file like this one before the command line, and takes from
# it whatever the command line does not say. It reads the first of
# $DNSTREE_CONFIG, $XDG_CONFIG_HOME/dnstree/config (~/.config/dnstree/config
# where that is unset, %AppData%\dnstree\config on Windows) and ~/.dnstreerc.
#
# One long flag name per line, with the value it takes. The dashes are
# optional, "name value" works as well as "name = value", and a flag that
# stands on its own needs no value at all. Only a line opening with # is a
# comment: a # partway along a line is part of the value, so a setting and
# what it is for go on separate lines.
#
# The command line is read last and wins. --format ascii beats a format set
# here, --dnssec=false turns off a flag set here, and --no-config ignores the
# file altogether. Flags that answer one question in different ways give way
# together: name any transport on the command line and whichever this file
# chose is dropped rather than collided with, and the same goes for the
# address family, for where the walk starts, and for how TLS is verified.
#
# Every setting below is commented out, written as "name = value" so that a
# test can check each one still parses, and carrying its default where it has
# one, or an example where only a change is worth writing. Uncomment what you
# want.


# What to follow

# Ask for signatures and follow the chain of trust. A broken one is exit code
# 3, which a script reading the answer wants to know about first.
# dnssec = true

# Ask every nameserver of a zone rather than the first that answers. Slower,
# and the only way to see one server of a set disagree with the others.
# all = true

# Ask the zone that answered for its own NS set and its nameservers' addresses,
# and compare them with the delegation and its glue. A mismatch is a real
# delegation fault that still resolves.
# check-ns = true

# Ask the zone for the CDS and CDNSKEY it publishes to ask its parent for a new
# DS, and compare them with the DS the parent holds: a request nobody acted on is
# a key rollover stuck halfway. Two queries, and it needs dnssec beside it.
# dnssec = true
# check-ds = true

# Ask every nameserver of the zone which copy of it they are serving, and say
# so when they do not all serve the same one. A secondary a transfer left
# behind answers correctly, out of an older zone. One query per nameserver.
# serial = true

# Ask each server which of itself answered (RFC 5001). One anycast address is a
# great many machines, and this is the only thing in a reply that tells them
# apart. It costs no query of its own.
# nsid = true

# Send each server a DNS cookie (RFC 7873), and say on each hop whether it
# answered with one. It costs no query of its own.
# cookie = true

# Ask the domain's registry when its registration runs out and whether it is
# on hold, and compare the nameservers and DS it holds with the TLD's. These
# are HTTPS requests to the registry IANA names, the only ones that are not
# DNS, and each domain is asked about once an hour at most.
# rdap = true

# Ask each zone for no more of the name than it needs, the way resolvers do by
# default now (RFC 9156). It finds the server that denies a name for being
# empty, which stops such a resolver dead. A query per label below the zone.
# qmin = true

# Ask as though the question came from somebody inside this network, which is
# how a server that answers by where you are can be asked what it tells
# somewhere else. A bare address is read as the /24 or /56 around it. Every
# server on the way down is told, so this is a thing to ask for rather than a
# thing to leave on.
# subnet = 203.0.113.0/24



# How to ask

# Ask only IPv4 servers, or write 6 for only IPv6. The two are alternatives,
# so naming either on the command line replaces this line.
# 4 = true

# Carry the queries over TCP, TLS or HTTPS instead of plain DNS: tcp, dot or
# doh, one at a time. Plain UDP is what a walk does without any of them.
# dot = true

# Let plain DNS pick up a hop the chosen transport could not reach, rather
# than leaving it in the tree as a failure.
# fallback = true

# How long one query may take, and how often to ask again after a silence.
# timeout = 2s
# retries = 1

# The port nameservers are asked on, for a test bed that does not use 53 (or
# 853 with dot, 443 with doh).
# port = 5353


# What to draw

# tree, ascii, emoji, waterfall, waterfall-ascii, waterfall-mermaid, markdown,
# json, dot, mermaid, openmetrics, web or web-3d. ascii emits nothing above
# codepoint 127, for pasting somewhere that cannot carry box drawing.
# format = tree

# waterfall draws the walk as a timeline, one bar per query, to show where the
# time went and what was asked at the same time. waterfall-ascii is the same in
# # and ., and waterfall-mermaid the same as a Mermaid gantt chart.
# format = waterfall

# web draws nothing in the terminal. It serves the finished walk as a page on
# this machine, opens a browser at it, and keeps serving until the command is
# interrupted. The address it listens on is where a browser can reach it;
# no-browser leaves the printed address to be opened by hand. web-3d does the
# same with a scene to turn around instead of a tree to read.
# format = web
# web-addr = 127.0.0.1:0
# no-browser = true

# Draw the tree as the walk makes it. Asking for any format but tree, ascii or
# emoji on the command line drops this line rather than failing on it, since
# all the others are written once at the end.
# live = true

# Say in sentences what the walk came to, under the tree. Asking for json, dot,
# mermaid, waterfall-mermaid or openmetrics on the command line drops this line
# rather than failing on it, since all five are read by a program and carry the
# same facts in fields.
# explain = true

# Say what has changed since the last walk of the same question, and remember
# this one in its place. It is the one thing here that writes to the disk: one
# file per question under $DNSTREE_CACHE, $XDG_CACHE_HOME/dnstree or
# ~/.cache/dnstree (%LocalAppData%\dnstree on Windows), naming what was looked
# up and when. Asking for json, dot, mermaid, waterfall-mermaid or openmetrics on
# the command line drops this line too.
# diff = true

# auto, always or never. auto colours a terminal and nothing else, and not
# even that where NO_COLOR is set or TERM is unset or dumb.
# color = auto

# Skip the origin AS lookups. They are questions to Team Cymru, through a
# resolver, rather than to the zone's own servers, which is what to weigh
# where nothing may leave the host.
# no-asn = true

# Do not put the same question to a recursive server. The timing that comes
# back is what says whether a slow walk was the name's doing or the method's,
# and, --spf and --report aside, it is the one thing that sends the name being
# resolved to a resolver.
# no-compare = true

# The recursive server to use for all four, instead of the host's own: the
# origin AS lookups, the question timed against an ordinary resolution, a
# report --report sends and the lookups --spf makes. Write a line for each one
# the question should go to, and it goes to all of them at once; the origin AS
# lookups use the first. One --resolver on the command line replaces every one
# of them.
# resolver = 9.9.9.9

# Ask each of those resolvers which encrypted resolvers stand for it (RFC
# 9462), and say what they offer. It is a query per resolver, and nothing
# connects to what comes back, so no offer is verified.
# ddr = true


# Where the walk starts

# Roots of your own, instead of the built-in hints. Repeat the line for every
# server the walk may start from. One --root on the command line replaces
# every line here rather than adding to them, and so does --root-hints.
# root = a.root.test@192.0.2.53
# root = b.root.test@192.0.2.54

# A hints file, as the alternative to the root lines above.
# root-hints = /etc/dnstree/root.hints

# The DS records to trust. A walk that starts off the real root usually wants
# its own anchors with it, or the chain has nothing to end at.
# trust-anchors = /etc/dnstree/anchors.txt


# What bounds a walk

# Zone cuts followed, queries made in total, aliases chased. Every walk ends;
# these say when. all raises the queries to 256, and check and deps to 512,
# only where this file leaves max-queries unset.
# max-depth = 16
# max-queries = 64
# max-cname = 8


# Reaching a test server

# Verify --dot and --doh against these roots rather than the system's.
# dot = true
# tls-ca = /etc/ssl/certs/ca-certificates.crt

# Or do not verify them at all, which only a certificate you issued deserves.
# dot = true
# tls-insecure = true


# Debugging

# Report every hop on stderr as it is made.
# debug = true
